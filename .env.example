# Configuration EmailJS pour Fyndra
# Copiez ce fichier vers .env.local et remplissez avec vos vraies valeurs

# Service ID - Obtenez-le depuis https://dashboard.emailjs.com/admin
VITE_EMAILJS_SERVICE_ID=your_service_id_here

# Template ID pour Early Access - Créez un template et copiez l'ID
VITE_EMAILJS_TEMPLATE_ID=your_early_access_template_id_here

# Template ID pour Contact - Créez un second template pour les messages de contact
VITE_EMAILJS_CONTACT_TEMPLATE_ID=your_contact_template_id_here

# Public Key - Trouvez-la dans Account > General
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# DÉPLOIEMENT:
# Pour Cloudflare Pages: Dashboard → Workers & Pages → Votre projet → Settings → Environment variables
# Ajoutez les 3 variables ci-dessus pour Production

# Consultez EMAILJS_SETUP_GUIDE.md pour la configuration complète
